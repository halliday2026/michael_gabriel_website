---
import { t, trail, pageUrl, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const dict = t(lang);
const crumbs = trail(page);
---

<nav aria-label={dict.ui.breadcrumb} class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-ink/70">
    {crumbs.map((p, i) => {
      const last = i === crumbs.length - 1;
      return (
        <li class="flex items-center gap-1">
          {i > 0 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-ink/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          )}
          {last ? (
            <span aria-current="page" class="font-medium text-brand">{dict.menu[p]}</span>
          ) : (
            <a href={pageUrl(p, lang)} class="hover:text-accent hover:underline">{dict.menu[p]}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
