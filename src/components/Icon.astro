---
// Line icons in the site's outline style (24×24, round caps, currentColor stroke).
interface Props {
  name: 'cross' | 'candle' | 'hand';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'cross' && (
    <>
      <!-- Orthodox three-bar cross: titlos, main bar, slanted footrest -->
      <path d="M12 2.5v19" />
      <path d="M9.5 5.5h5" />
      <path d="M6.5 9.5h11" />
      <path d="M9 15.5l6 2.5" />
    </>
  )}
  {name === 'candle' && (
    <>
      <!-- Lit candle on a holder -->
      <path d="M12 2.75c1.6 1.9 2.25 3.1 2.25 4.15a2.25 2.25 0 1 1-4.5 0c0-1.05.65-2.25 2.25-4.15z" />
      <path d="M12 9.25v1.5" />
      <rect x="9.25" y="10.75" width="5.5" height="8.5" rx="0.75" />
      <path d="M6.5 21.25h11" />
    </>
  )}
  {name === 'hand' && (
    <!-- Raised (waving) hand -->
    <path d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002" />
  )}
</svg>
