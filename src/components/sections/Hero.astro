---
import Section from '../Section.astro';
import Button from '../Button.astro';
import { t, pageUrl, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const { hero } = dict;
const base = import.meta.env.BASE_URL;
---

<Section tone="default" class="pt-10 sm:pt-14">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      <!-- Patron feast line -->
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">
        {hero.patronFeast}
      </p>

      <!-- Church name -->
      <h1 class="font-display text-3xl font-bold leading-tight text-brand sm:text-4xl lg:text-5xl">
        {dict.church.name}
      </h1>

      <!-- Welcome tagline -->
      <p class="mt-4 max-w-prose text-lg text-ink/75">
        {hero.welcome}
      </p>

      <!-- Liturgy time badge -->
      <div class="mt-6 inline-flex items-center gap-2 rounded-(--radius) bg-brand px-4 py-2 text-sm font-semibold text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{hero.liturgyBadge}</span>
      </div>

      <!-- CTAs -->
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={pageUrl('visit', lang)} variant="solid">{dict.menu.visit}</Button>
        <Button href={pageUrl('donate', lang)} variant="gold">{dict.menu.donate}</Button>
        <Button href={pageUrl('visit', lang, 'contact')} variant="outline">{dict.footer.contactHeading}</Button>
      </div>
    </div>

    <!-- Church photo with church seal badge -->
    <div class="relative pb-48 lg:pb-24">
      <div class="overflow-hidden rounded-(--radius) shadow-xl w-3/4 mx-auto">
        <img
          src={`${base}church_front.jpg`}
          alt={dict.images.churchFrontAlt}
          class="w-full h-auto block"
        />
      </div>
      <!-- Church seal badge — centered below photo -->
      <img
        src={`${base}roc_logo.png`}
        alt={dict.images.sealAlt}
        width="267"
        height="266"
        class="absolute bottom-0 left-1/2 -translate-x-1/2 h-48 w-48 rounded-full shadow-xl ring-4 ring-accent/60 bg-surface"
      />
    </div>
  </div>
</Section>
