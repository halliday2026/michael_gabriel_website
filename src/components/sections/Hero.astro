---
import { Picture, Image } from 'astro:assets';
import Section from '../Section.astro';
import HeroCards from '../HeroCards.astro';
import { site } from '../../data/site';
import { t, type Locale } from '../../i18n';
import churchFront from '../../assets/images/church_front.jpg';
import seal from '../../assets/images/roc_logo.png';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const { hero } = dict;

// Configurable announcement line (site.announcement). Evaluated at build time and
// again in the browser, so a date range stays accurate between deploys.
const { enabled, start, end } = site.announcement;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
const inRange = (!start || today >= start) && (!end || today <= end);
---

<Section tone="default" class="pt-10 sm:pt-14">
  <!-- DOM order = mobile order: text → cards → photo. Desktop: text | photo, cards full-width below. -->
  <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-x-12">
    <div class="lg:col-start-1 lg:row-start-1">
      <!-- Announcement line (default: patronal feast) -->
      {enabled && (
        <p
          id="hero-announcement"
          class:list={[
            'mb-3 text-sm font-semibold uppercase tracking-widest text-accent-deep lg:whitespace-nowrap lg:tracking-wide xl:tracking-widest',
            !inRange && 'hidden',
          ]}
          data-start={start || undefined}
          data-end={end || undefined}
        >
          {hero.announcement}
        </p>
      )}

      <!-- Church name -->
      <h1 class="font-display text-3xl font-bold leading-tight text-brand sm:text-4xl lg:text-5xl">
        {dict.church.name}
      </h1>

      <!-- Welcome tagline -->
      <p class="mt-4 max-w-prose text-lg text-ink/75 sm:text-xl">
        {hero.welcome}
      </p>
    </div>

    <!-- Fr. Florin's three primary actions -->
    <div class="lg:col-span-2 lg:row-start-2">
      <HeroCards lang={lang} />
    </div>

    <!-- Church photo with church seal badge -->
    <div class="relative pb-48 lg:col-start-2 lg:row-start-1 lg:pb-24">
      <div class="mx-auto w-3/4 overflow-hidden rounded-(--radius) shadow-xl lg:w-4/5">
        <!-- Above the fold: load eagerly with high priority (LCP image) -->
        <Picture
          src={churchFront}
          alt={dict.images.churchFrontAlt}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 1280px) 330px, (min-width: 1024px) 26vw, 75vw"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
      <!-- Church seal badge — centered below photo -->
      <Image
        src={seal}
        alt={dict.images.sealAlt}
        width={192}
        height={192}
        densities={[1, 2]}
        format="webp"
        class="absolute bottom-0 left-1/2 h-48 w-48 -translate-x-1/2 rounded-full bg-surface shadow-xl ring-4 ring-accent/60"
      />
    </div>
  </div>
</Section>

<script>
  const line = document.getElementById('hero-announcement');
  if (line && (line.dataset.start || line.dataset.end)) {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
    const { start, end } = line.dataset;
    line.classList.toggle('hidden', !((!start || today >= start) && (!end || today <= end)));
  }
</script>
