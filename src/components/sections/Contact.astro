---
import Section from '../Section.astro';
import { site } from '../../data/site';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  id?: string;
}

const { lang, id = 'contact' } = Astro.props;
const { formspreeEndpoint } = site;
const { contact } = t(lang);

const inputClass =
  'mt-2 block w-full rounded-(--radius) border border-ink/20 bg-surface px-4 py-2 text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

<Section id={id} tone="muted">
  <h2 class="font-display text-3xl font-bold text-brand sm:text-4xl">
    {contact.heading}
  </h2>
  <p class="mt-4 max-w-prose text-lg text-ink/80">
    {contact.body}
  </p>

  <div id="contact-thankyou" class="mt-8 hidden max-w-xl rounded-(--radius) bg-accent/10 px-6 py-8 text-center ring-1 ring-accent/30" role="status" tabindex="-1">
    <p class="font-display text-2xl font-bold text-brand">{contact.thanksHeading}</p>
    <p class="mt-2 text-ink/80">{contact.thanksBody}</p>
  </div>

  <!-- Formspree AJAX submit: success swaps the form for the thank-you panel; failure shows #contact-error -->
  <form
    id="contact-form"
    method="POST"
    action={formspreeEndpoint}
    class="mt-8 grid max-w-xl gap-6"
    data-sending={contact.sending}
    data-submit={contact.submit}
  >
    <input type="hidden" name="language" value={lang} />

    <div>
      <label for="contact-name" class="block font-medium text-ink">{contact.nameLabel}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required placeholder={contact.namePlaceholder} class={inputClass} />
    </div>

    <div>
      <label for="contact-email" class="block font-medium text-ink">{contact.emailLabel}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder={contact.emailPlaceholder} class={inputClass} />
    </div>

    <div>
      <label for="contact-message" class="block font-medium text-ink">{contact.messageLabel}</label>
      <textarea id="contact-message" name="message" rows="5" required placeholder={contact.messagePlaceholder} class={inputClass}></textarea>
    </div>

    <div class="flex flex-col gap-3">
      <button
        type="submit"
        id="contact-submit"
        class="inline-flex w-fit items-center justify-center rounded-(--radius) bg-brand px-6 py-3 font-semibold text-surface transition-colors hover:bg-royal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-60"
      >
        {contact.submit}
      </button>
      <p id="contact-error" class="hidden text-sm text-highlight" role="alert">{contact.error}</p>
    </div>
  </form>
</Section>

<script>
  const form   = document.getElementById('contact-form') as HTMLFormElement | null;
  const thanks = document.getElementById('contact-thankyou') as HTMLElement | null;
  const btn    = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const error  = document.getElementById('contact-error') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !thanks || !error) return;
    btn.disabled = true;
    btn.textContent = form.dataset.sending ?? '';
    error.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form),
      });

      if (!res.ok) throw new Error('non-ok response');
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
      thanks.focus();
    } catch {
      error.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = form.dataset.submit ?? '';
    }
  });
</script>
