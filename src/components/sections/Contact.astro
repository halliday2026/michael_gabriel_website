---
import Section from '../Section.astro';
import { site } from '../../data/site';
import { t, type Locale } from '../../i18n';
import { inputClass, submitClass } from '../forms';

interface Props {
  lang: Locale;
  id?: string;
}

const { lang, id = 'contact' } = Astro.props;
const { contact } = t(lang);
---

<Section id={id} tone="muted">
  <h2 class="font-display text-3xl font-bold text-brand sm:text-4xl">
    {contact.heading}
  </h2>
  <p class="mt-4 max-w-prose text-lg text-ink/80">
    {contact.body}
  </p>

  <div id="contact-thankyou" class="mt-8 hidden max-w-xl rounded-(--radius) bg-accent/10 px-6 py-8 text-center ring-1 ring-accent/30" role="status" tabindex="-1">
    <p class="font-display text-2xl font-bold text-brand">{contact.thanksHeading}</p>
    <p class="mt-2 text-ink/80">{contact.thanksBody}</p>
  </div>

  <!-- Formspree AJAX submit (src/scripts/ajax-form.ts) -->
  <form
    id="contact-form"
    method="POST"
    action={site.formspreeEndpoint}
    class="mt-8 grid max-w-xl gap-6"
    data-ajax-form
    data-success="contact-thankyou"
    data-sending={contact.sending}
    data-submit={contact.submit}
  >
    <input type="hidden" name="_subject" value="Website contact form" />
    <input type="hidden" name="language" value={lang} />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div>
      <label for="contact-name" class="block font-medium text-ink">{contact.nameLabel}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required placeholder={contact.namePlaceholder} class={inputClass} />
    </div>

    <div>
      <label for="contact-email" class="block font-medium text-ink">{contact.emailLabel}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required placeholder={contact.emailPlaceholder} class={inputClass} />
    </div>

    <div>
      <label for="contact-message" class="block font-medium text-ink">{contact.messageLabel}</label>
      <textarea id="contact-message" name="message" rows="5" required placeholder={contact.messagePlaceholder} class={inputClass}></textarea>
    </div>

    <div class="flex flex-col gap-3">
      <button type="submit" class={submitClass}>{contact.submit}</button>
      <p class="hidden text-sm text-highlight-deep" role="alert" data-form-error>{contact.error}</p>
    </div>
  </form>
</Section>

<script>
  import '../../scripts/ajax-form';
</script>
