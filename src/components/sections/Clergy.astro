---
import Section from '../Section.astro';
import { site, telHref } from '../../data/site';
import { t, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  id?: string;
}

const { lang, id = 'clergy' } = Astro.props;
const { clergy } = t(lang);
---

<Section id={id} tone="default">
  <h2 class="font-display text-3xl font-bold text-brand sm:text-4xl">
    {clergy.heading}
  </h2>

  <!-- Priest card -->
  <div class="mt-8 max-w-lg rounded-(--radius) border border-muted bg-muted p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent">
      {clergy.subhead}
    </p>
    <p class="mt-2 font-display text-xl font-bold text-brand">
      {clergy.name}
    </p>

    <dl class="mt-4 space-y-2 text-sm text-ink/80">
      <div class="flex gap-2">
        <dt class="font-semibold text-brand shrink-0">{clergy.phoneLabel}</dt>
        <dd>
          <a href={telHref(site.contact.phone)} class="hover:text-accent">{site.contact.phone}</a>
        </dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-semibold text-brand shrink-0">{clergy.emailLabel}</dt>
        <dd>
          <a href={`mailto:${site.contact.email}`} class="hover:text-accent">{site.contact.email}</a>
        </dd>
      </div>
    </dl>
  </div>

  <p class="mt-6 max-w-prose text-ink/70">
    {clergy.note}
  </p>
</Section>
