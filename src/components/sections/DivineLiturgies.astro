---
import { t, pageUrl, type Locale } from '../../i18n';

interface Props {
  lang: Locale;
  id?: string;
}

const { lang, id = 'services' } = Astro.props;
const { liturgies, worshipPage } = t(lang);
const calendarHref = pageUrl('newsEvents', lang, 'calendar');

// `tba` rows link their "To be announced" schedule to the parish calendar
const rows = [
  { ...liturgies.vespers,    tba: true },
  { ...liturgies.confession, tba: false },
  { ...liturgies.feastDays,  tba: true },
];
---

<!-- Dark navy section — override Section tone with a wrapper -->
<section id={id} class="bg-brand py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <h2 class="font-display text-3xl font-bold text-accent sm:text-4xl">
      {liturgies.heading}
    </h2>

    <!-- Services table -->
    <div class="mt-8 overflow-x-auto rounded-(--radius) ring-1 ring-surface/10">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b border-surface/10 bg-surface/5">
            <th scope="col" class="px-4 py-3 font-semibold text-accent">{liturgies.colService}</th>
            <th scope="col" class="px-4 py-3 font-semibold text-accent">{liturgies.colSchedule}</th>
            <th scope="col" class="px-4 py-3 font-semibold text-accent">{liturgies.colLanguage}</th>
          </tr>
        </thead>
        <tbody>
          <!-- Sunday Divine Liturgy — highlighted row -->
          <tr class="border-b border-surface/10 bg-accent/10">
            <th scope="row" class="px-4 py-4 font-semibold text-surface">{liturgies.sunday.name}</th>
            <td class="px-4 py-4 text-surface/90">{liturgies.sunday.schedule}</td>
            <td class="px-4 py-4 text-surface/90">{liturgies.sunday.language}</td>
          </tr>

          {rows.map((row, i) => (
            <tr class:list={['hover:bg-surface/5', i < rows.length - 1 && 'border-b border-surface/10']}>
              <th scope="row" class="px-4 py-4 font-normal text-surface/80">{row.name}</th>
              <td class="px-4 py-4 italic text-surface/70">
                {row.tba ? (
                  <a href={calendarHref} class="underline decoration-accent/60 underline-offset-4 hover:text-accent">
                    {row.schedule}<span class="sr-only"> — {worshipPage.tbaCalendar}</span>
                  </a>
                ) : row.schedule}
              </td>
              <td class="px-4 py-4 italic text-surface/70">{row.language}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Note about private services -->
    <p class="mt-6 text-sm text-surface/70">
      {liturgies.note}
    </p>

    {Astro.slots.has('default') && (
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3"><slot /></div>
    )}
  </div>
</section>
