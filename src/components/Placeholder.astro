---
// Visible, easy-to-find marker for content the parish still needs to supply.
// Pair every use with an HTML `<!-- TODO(content): … -->` comment at the call site.
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  kind?: 'content' | 'photo';
}

const { lang, kind = 'content' } = Astro.props;
const dict = t(lang);
---

{kind === 'photo' ? (
  <div class="flex aspect-video w-full items-center justify-center rounded-(--radius) border-2 border-dashed border-accent/50 bg-accent/5 px-4 text-center text-sm italic text-ink/70" data-placeholder="photo">
    {dict.ui.photoComingSoon}
  </div>
) : (
  <p class="rounded-(--radius) border border-dashed border-accent/60 bg-accent/5 px-4 py-3 text-sm italic text-ink/70" data-placeholder="content">
    {dict.ui.comingSoon}
  </p>
)}
