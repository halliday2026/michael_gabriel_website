---
import Container from './Container.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { t, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: Exclude<PageKey, 'home'>;
}

const { lang, page } = Astro.props;
const { heading, intro } = t(lang).pages[page];
---

<!-- Interior page header: breadcrumbs, the page's single h1, and a factual opening summary -->
<section class="border-b border-muted bg-muted py-10 sm:py-14">
  <Container>
    <Breadcrumbs lang={lang} page={page} />
    <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-brand sm:text-4xl lg:text-5xl">
      {heading}
    </h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink/80">{intro}</p>
    <slot />
  </Container>
</section>
