---
import { Image } from 'astro:assets';
import seal from '../assets/images/roc_logo.png';
import { t, menu, locales, languageNames, pageUrl, trail, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const dict = t(lang);
const labels = dict.menu as Record<string, string>;
const activeTrail = trail(page);

// Highlight the current page and its section parent; aria-current only on the exact page.
const isActive = (p: PageKey) => (p === 'home' ? page === 'home' : activeTrail.includes(p));
const current = (p: PageKey) => (p === page ? 'page' : undefined);
const linkHref = (p: PageKey, hash?: string) => pageUrl(p, lang, hash);
---

<header class="sticky top-0 z-50 border-b border-muted bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/80">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">

    <!-- Logo mark → home page in the current language.
         The full round parish seal: the old header_logo.png was cut flat through the icon. -->
    <a href={pageUrl('home', lang)} class="shrink-0 rounded-full">
      <Image
        src={seal}
        alt={dict.images.headerLogoAlt}
        width={56}
        height={56}
        densities={[1, 2]}
        format="webp"
        loading="eager"
        class="h-12 w-12 rounded-full bg-surface shadow-sm ring-2 ring-accent/60 sm:h-14 sm:w-14"
      />
    </a>

    <!-- Desktop menu (≥1280px) -->
    <nav class="hidden xl:block" aria-label={dict.ui.mainNav}>
      <ul class="flex items-center">
        {menu.map((item) =>
          item.children ? (
            <li class="group relative" data-dropdown>
              <div class="flex items-center">
                <a
                  href={linkHref(item.page)}
                  aria-current={current(item.page)}
                  class:list={[
                    'whitespace-nowrap rounded-(--radius) py-2 pl-2 text-sm font-medium hover:text-accent',
                    isActive(item.page) ? 'text-royal' : 'text-ink',
                  ]}
                >
                  {labels[item.key]}
                </a>
                <button
                  type="button"
                  data-dropdown-toggle
                  aria-expanded="false"
                  aria-controls={`dd-${item.key}`}
                  aria-label={`${dict.ui.showSubmenu}: ${labels[item.key]}`}
                  class="rounded-(--radius) py-2 pl-0.5 pr-1.5 text-ink/60 hover:text-accent"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 transition-transform group-data-[open=true]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
              <ul
                id={`dd-${item.key}`}
                class="absolute left-0 top-full z-50 hidden min-w-60 rounded-(--radius) bg-surface py-2 shadow-lg ring-1 ring-muted group-hover:block group-data-[open=true]:block"
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={linkHref(child.page, child.hash)}
                      class="block whitespace-nowrap px-4 py-2 text-sm text-ink hover:bg-muted hover:text-brand"
                    >
                      {labels[child.key]}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={linkHref(item.page)}
                aria-current={current(item.page)}
                class:list={[
                  'block whitespace-nowrap rounded-(--radius) px-2 py-2 text-sm font-medium hover:text-accent',
                  isActive(item.page) ? 'text-royal' : 'text-ink',
                ]}
              >
                {labels[item.key]}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language toggle: links to this same page in the other languages -->
      <div class="hidden items-center gap-1 xl:flex" role="group" aria-label={dict.ui.language}>
        {locales.map((l) => (
          <a
            href={pageUrl(page, l)}
            hreflang={l}
            lang={l}
            data-lang-link={l}
            aria-label={languageNames[l]}
            aria-current={l === lang ? 'true' : undefined}
            class:list={[
              'rounded-(--radius) border px-2.5 py-1 text-xs font-bold tracking-wide transition-all',
              l === lang
                ? 'border-accent bg-accent text-brand shadow-sm'
                : 'border-ink/20 bg-transparent text-ink/70 hover:border-accent-deep hover:text-accent-deep',
            ]}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-(--radius) p-2 text-brand xl:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
      >
        <span class="sr-only">{dict.ui.openMenu}</span>
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile accordion menu (<1280px) -->
  <nav
    id="nav-mobile-menu"
    class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-muted bg-surface px-4 pb-4 pt-2 xl:hidden"
    aria-label={dict.ui.mainNav}
  >
    <ul class="flex flex-col">
      {menu.map((item) => (
        <li class="group border-b border-muted" data-accordion>
          <div class="flex items-center justify-between">
            <a
              href={linkHref(item.page)}
              aria-current={current(item.page)}
              class:list={[
                'block flex-1 px-2 py-3 font-medium hover:text-accent',
                isActive(item.page) ? 'text-royal' : 'text-ink',
              ]}
            >
              {labels[item.key]}
            </a>
            {item.children && (
              <button
                type="button"
                data-accordion-toggle
                aria-expanded="false"
                aria-controls={`m-${item.key}`}
                aria-label={`${dict.ui.showSubmenu}: ${labels[item.key]}`}
                class="rounded-(--radius) p-3 text-ink/60 hover:text-accent"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-data-[open=true]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            )}
          </div>
          {item.children && (
            <ul id={`m-${item.key}`} class="hidden pb-2 pl-4 group-data-[open=true]:block">
              {item.children.map((child) => (
                <li>
                  <a href={linkHref(child.page, child.hash)} class="block px-2 py-2 text-sm text-ink/80 hover:text-accent">
                    {labels[child.key]}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <!-- Mobile language toggle -->
    <div class="mt-3 flex items-center gap-2 pt-1" role="group" aria-label={dict.ui.language}>
      <span class="text-xs font-medium text-ink/70" aria-hidden="true">{dict.ui.language}:</span>
      {locales.map((l) => (
        <a
          href={pageUrl(page, l)}
          hreflang={l}
          lang={l}
          data-lang-link={l}
          aria-label={languageNames[l]}
          aria-current={l === lang ? 'true' : undefined}
          class:list={[
            'rounded-(--radius) border px-3 py-1.5 text-xs font-bold tracking-wide transition-all',
            l === lang
              ? 'border-accent bg-accent text-brand shadow-sm'
              : 'border-ink/20 bg-transparent text-ink/70 hover:border-accent-deep hover:text-accent-deep',
          ]}
        >
          {l.toUpperCase()}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // --- Desktop dropdowns: disclosure buttons; hover handled in CSS -----------
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

  function setOpen(li: HTMLElement, open: boolean) {
    li.dataset.open = String(open);
    li.querySelector('[data-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
  }

  dropdowns.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-dropdown-toggle]');
    btn?.addEventListener('click', () => {
      const open = li.dataset.open !== 'true';
      dropdowns.forEach((other) => other !== li && setOpen(other, false));
      setOpen(li, open);
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node | null)) setOpen(li, false);
    });
    li.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && li.dataset.open === 'true') {
        setOpen(li, false);
        btn?.focus();
      }
    });
  });

  document.addEventListener('click', (e) => {
    dropdowns.forEach((li) => !li.contains(e.target as Node) && setOpen(li, false));
  });

  // --- Mobile menu + accordion -------------------------------------------------
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setMobile(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    mobileMenu?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setMobile(toggle.getAttribute('aria-expanded') !== 'true'));

  mobileMenu?.querySelectorAll<HTMLElement>('[data-accordion]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-accordion-toggle]');
    btn?.addEventListener('click', () => {
      const open = li.dataset.open !== 'true';
      li.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });

  // Close the mobile menu after following a link (same-page anchors included)
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobile(false)));

  // --- Remember the visitor's language choice (convenience only; never redirects)
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((link) => {
    link.addEventListener('click', () => {
      try { localStorage.setItem('locale', link.dataset.langLink ?? ''); } catch {}
    });
  });
</script>
