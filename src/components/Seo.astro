---
import { site } from '../data/site';
import { t, locales, defaultLocale, ogLocale, pageUrl, type Locale, type PageKey } from '../i18n';

interface Props {
  lang: Locale;
  page: PageKey;
  image?: string;
}

const { lang, page, image } = Astro.props;
const dict = t(lang);
const { title, description } = dict.meta[page];

const abs = (path: string) => new URL(path, Astro.site).href;
const canonicalURL = abs(pageUrl(page, lang));
const resolvedImage = abs(`${import.meta.env.BASE_URL}${image ?? 'church_front.jpg'}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': ['Church', 'LocalBusiness'],
  name: site.name,
  description: t('en').meta.home.description,
  url: site.url,
  telephone: site.contact.phone,
  email: site.contact.emailGeneral,
  address: {
    '@type': 'PostalAddress',
    streetAddress:   site.contact.streetAddress,
    addressLocality: site.contact.addressLocality,
    addressRegion:   site.contact.addressRegion,
    postalCode:      site.contact.postalCode,
    addressCountry:  'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: 'Sunday',
    opens:  '10:00',
    closes: '11:50',
    description: 'Divine Liturgy in Romanian and English',
  },
  employee: {
    '@type': 'Person',
    name:      'Rev. Fr. Florin Iftode',
    jobTitle:  'Parish Priest',
    telephone: site.contact.phone,
    email:     site.contact.email,
  },
  areaServed: 'Coachella Valley and Inland Empire',
  image: `${site.url}/church_front.jpg`,
  logo:  `${site.url}/roc_logo.png`,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Language alternates -->
{locales.map((l) => <link rel="alternate" hreflang={l} href={abs(pageUrl(page, l))} />)}
<link rel="alternate" hreflang="x-default" href={abs(pageUrl(page, defaultLocale))} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={dict.church.name} />
<meta property="og:locale" content={ogLocale[lang]} />
{locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={dict.images.churchFrontAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={dict.images.churchFrontAlt} />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
