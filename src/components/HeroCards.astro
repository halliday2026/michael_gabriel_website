---
// Fr. Florin's three large homepage buttons. Three across on desktop, stacked on mobile.
import Icon from './Icon.astro';
import { t, pageUrl, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { cards } = t(lang).home;

const items = [
  { ...cards.liturgy,  icon: 'cross',  href: pageUrl('worship', lang, 'liturgy') },
  { ...cards.prayer,   icon: 'candle', href: pageUrl('prayer', lang, 'request') },
  { ...cards.newcomer, icon: 'hand',   href: pageUrl('whatToExpect', lang) },
] as const;
---

<ul class="grid gap-4 md:grid-cols-3 md:gap-6">
  {items.map((item) => (
    <li class="flex">
      <a
        href={item.href}
        class="group flex w-full min-h-28 items-center gap-4 rounded-(--radius) bg-brand p-5 text-left shadow-lg ring-1 ring-accent/30 transition hover:-translate-y-0.5 hover:shadow-xl hover:ring-accent focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-accent sm:p-6 md:flex-col md:items-start md:gap-3"
      >
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent ring-1 ring-accent/40 transition group-hover:bg-accent/25">
          <Icon name={item.icon} class="h-8 w-8" />
        </span>
        <span class="flex flex-col">
          <span class="font-display text-xl font-bold leading-snug text-surface sm:text-2xl">{item.title}</span>
          <span class="mt-1 text-base text-surface/80">{item.subtitle}</span>
        </span>
      </a>
    </li>
  ))}
</ul>
