---
import PageHeader from '../components/PageHeader.astro';
import PageSection from '../components/PageSection.astro';
import PlaceholderSection from '../components/PlaceholderSection.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import { t, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = t(lang);
const l = dict.learnPage;
---

<PageHeader lang={lang} page="learn" />

<PageSection id="beliefs" heading={dict.menu.beliefs}>
  <!-- REVIEW(Fr. Florin): What We Believe summary and Creed translations (EN / ES / RO). -->
  <Prose paragraphs={l.beliefs} />
  <figure class="rounded-(--radius) border border-accent/40 bg-muted p-6 sm:p-8">
    <figcaption class="font-display text-2xl font-bold text-brand">{l.creedHeading}</figcaption>
    <blockquote class="mt-4 space-y-2 font-display text-lg italic leading-relaxed text-ink/85">
      {l.creed.map((line) => <p>{line}</p>)}
    </blockquote>
  </figure>
  <Prose paragraphs={[l.beliefsClosing]} />
</PageSection>

<PageSection id="orthodox-faith" heading={dict.menu.orthodoxFaith} tone="muted">
  <!-- REVIEW(Fr. Florin): Orthodox Faith overview. -->
  <Prose paragraphs={l.orthodoxFaith} />
  <!-- TODO(content): Photo (iconostasis or icons) — from Fr. Florin. -->
  <Placeholder lang={lang} kind="photo" />
</PageSection>

<PlaceholderSection lang={lang} id="sermons" heading={dict.menu.sermons}>
  <!-- TODO(content): Sermon archive / teachings (text, audio or video links) — from the parish. -->
</PlaceholderSection>

<PageSection id="catechism" heading={dict.menu.catechism} tone="muted">
  <!-- REVIEW(Fr. Florin): catechism / catechumenate text. -->
  <Prose paragraphs={l.catechism} />
  <!-- TODO(content): Catechism class schedule and how to sign up — from the parish. -->
  <Placeholder lang={lang} />
</PageSection>
