---
import PageHeader from '../components/PageHeader.astro';
import PageSection from '../components/PageSection.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import NewsList from '../components/NewsList.astro';
import { announcements, parishNews } from '../data/news';
import { t, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = t(lang);
const n = dict.newsPage;
---

<PageHeader lang={lang} page="newsEvents" />

<PageSection id="calendar" heading={dict.menu.calendar} wide>
  <p class="max-w-3xl text-lg leading-relaxed text-ink/80">{n.calendarIntro}</p>
  <CalendarEmbed lang={lang} />
</PageSection>

<!-- Announcements and Parish News are edited in src/data/news.ts -->
<PageSection id="announcements" heading={dict.menu.announcements} tone="muted">
  <NewsList lang={lang} items={announcements} empty={n.noAnnouncements} />
</PageSection>

<PageSection id="news" heading={dict.menu.news}>
  <NewsList lang={lang} items={parishNews} empty={n.noNews} />
</PageSection>
