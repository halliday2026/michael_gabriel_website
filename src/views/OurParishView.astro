---
import PageHeader from '../components/PageHeader.astro';
import PageSection from '../components/PageSection.astro';
import PlaceholderSection from '../components/PlaceholderSection.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import Welcome from '../components/sections/Welcome.astro';
import Clergy from '../components/sections/Clergy.astro';
import { t, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const dict = t(lang);
---

<PageHeader lang={lang} page="ourParish" />
<Welcome lang={lang} id="about" summary={false} />
<Clergy lang={lang} />

<PlaceholderSection lang={lang} id="history" heading={dict.menu.history} tone="muted" photo>
  <!-- TODO(content): Parish history — founding date, founders, milestones, church building. Must come from the parish; do not invent. -->
</PlaceholderSection>

<PageSection id="tradition" heading={dict.menu.tradition}>
  <!-- REVIEW(Fr. Florin): general overview of the Romanian Orthodox tradition. -->
  <Prose paragraphs={dict.tradition} />
  <!-- TODO(content): Parish-specific customs (e.g. how the hram is celebrated here) and photos — from the parish. -->
  <!-- TODO(decision): Calendar style used by the parish (New / Old) — confirm before adding parish-specific calendar text. -->
  <Placeholder lang={lang} kind="photo" />
</PageSection>
