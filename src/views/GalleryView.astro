---
// Phase 4 replaces this simple grid with a data-driven gallery + lightbox.
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { t, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const alts = t(lang).images.carousel;
const base = import.meta.env.BASE_URL;
const photos = (['front', 'kids', 'night', 'picnic', 'service', 'side'] as const).map((key) => ({
  src: `${base}carousel/${key}.jpg`,
  alt: alts[key],
}));
---

<PageHeader lang={lang} page="gallery" />

<Section>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {photos.map((p) => (
      <li class="overflow-hidden rounded-(--radius) shadow-sm ring-1 ring-muted">
        <img src={p.src} alt={p.alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
      </li>
    ))}
  </ul>
</Section>
